NODE_ENV=development
HOST=0.0.0.0
PORT=4100
JWT_SECRET=replace-with-the-existing-royal-club-hs256-secret
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Coturn REST credentials for production WebRTC voice.
TURN_URL=turn:turn.example.com:3478?transport=udp
TURN_SHARED_SECRET=replace-with-coturn-static-auth-secret
TURN_TTL_SECONDS=3600
