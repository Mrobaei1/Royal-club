                const SizedBox(height: 8),
                Text('دنیایی از بازی‌های آنلاین، در یک تجربه ممتاز',
                    textAlign: TextAlign.center,
                    style:
                        TextStyle(color: Colors.white.withValues(alpha: 0.72))),
                const SizedBox(height: 24),
                SizedBox(
                    height: 54,
                    child: FilledButton.icon(
                        onPressed: () {
                          Navigator.of(context).push(MaterialPageRoute(
                              builder: (_) => const BackgammonScreen()));
                        },
                        icon: const Icon(Icons.casino),
                        label: const Text('شروع بازی تخته‌نرد',
                            style: TextStyle(
                                fontSize: 17, fontWeight: FontWeight.bold)),
                        style: FilledButton.styleFrom(
                            backgroundColor: gold,
                            foregroundColor: navy,
                            shape: RoundedRectangleBorder(
                                borderRadius: BorderRadius.circular(16))))),
                const SizedBox(height: 24),
                const GameTile(
                    title: 'تخته‌نرد',
                    subtitle: 'به‌زودی · بازی آنلاین دونفره',
                    icon: Icons.casino),
                const GameTile(
                    title: 'شطرنج',
                    subtitle: 'در برنامه توسعه',
                    icon: Icons.grid_4x4),
                const GameTile(
                    title: 'بازی‌های کارتی',
                    subtitle: 'حکم، چهاربرگ و موارد بیشتر',
                    icon: Icons.style),
                const SizedBox(height: 16),
                Text('نسخه آغازین رابط کاربری · 0.1.0',
                    textAlign: TextAlign.center,
                    style: TextStyle(
                        fontSize: 12,
                        color: Colors.white.withValues(alpha: 0.5))),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

class BackgammonScreen extends StatelessWidget {
  const BackgammonScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return Directionality(
      textDirection: TextDirection.rtl,
      child: Scaffold(
        appBar: AppBar(title: const Text("تخته‌نرد سلطنتی")),
        body: SafeArea(
          child: SingleChildScrollView(
            padding: const EdgeInsets.all(16),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                const Text("میز بازی",
                    textAlign: TextAlign.center,
                    style: TextStyle(
                        fontSize: 24,
                        fontWeight: FontWeight.bold,
                        color: gold)),
                const SizedBox(height: 8),
                const Text("آماده‌ای برای بازی؟", textAlign: TextAlign.center),
                const SizedBox(height: 24),
                Container(
                  decoration: BoxDecoration(
                    color: const Color(0xFF6D4026),
                    borderRadius: BorderRadius.circular(16),
                    border: Border.all(color: gold, width: 3),
                  ),
                  child: Stack(
                    children: [
                      Positioned.fill(
                        child: Center(
                          child: Container(width: 3, color: gold),
                        ),
                      ),
                      Column(
                        children: [
                          Row(
                              children: List.generate(
                                  12,
                                  (i) => Expanded(
                                        child: SizedBox(
                                          height: 105,
                                          child: Align(
                                            alignment: Alignment.topCenter,
                                            child: CustomPaint(
                                              size: const Size(24, 100),
                                              painter: _PointPainter(
                                                color: i.isEven
                                                    ? gold
                                                    : const Color(0xFF18233B),
                                                upsideDown: false,
                                              ),
                                            ),
                                          ),
                                        ),
                                      ))),
                          Row(children: [
                            Expanded(child: Container(height: 3, color: gold)),
                          ]),
                          Row(
                              children: List.generate(
                                  12,
                                  (i) => Expanded(
                                        child: SizedBox(
                                          height: 105,
                                          child: Align(
                                            alignment: Alignment.bottomCenter,
                                            child: Transform.rotate(
                                              angle: 3.14159,
                                              child: CustomPaint(
                                                size: const Size(24, 100),
                                                painter: _PointPainter(
                                                  color: i.isEven
                                                      ? gold
                                                      : const Color(0xFF18233B),
                                                  upsideDown: true,
                                                ),
                                              ),
                                            ),
                                          ),
                                        ),
                                      ))),
                        ],
                      ),
                    ],
                  ),
                ),
                const SizedBox(height: 24),
                Row(
                  mainAxisAlignment: MainAxisAlignment.center,
                  children: [
                    _DieFace(number: 3),
                    const SizedBox(width: 16),
                    _DieFace(number: 5),
                  ],
                ),
                const SizedBox(height: 24),
                const Text(
                    "نمای اولیه تخته؛ قوانین و حرکت مهره‌ها در مرحله بعد اضافه می‌شوند.",
                    textAlign: TextAlign.center,
                    style: TextStyle(color: Colors.white70)),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

class _PointPainter extends CustomPainter {
  const _PointPainter({
    required this.color,
    required this.upsideDown,
  });

  final Color color;
  final bool upsideDown;

  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = color
      ..style = PaintingStyle.fill;

    final path = Path();

    if (upsideDown) {
      path
        ..moveTo(0, size.height)
        ..lineTo(size.width, size.height)
        ..lineTo(size.width / 2, 0);
    } else {
      path
        ..moveTo(0, 0)
        ..lineTo(size.width, 0)
        ..lineTo(size.width / 2, size.height);
    }

    path.close();
    canvas.drawPath(path, paint);
  }

  @override
  bool shouldRepaint(covariant _PointPainter oldDelegate) {
    return color != oldDelegate.color || upsideDown != oldDelegate.upsideDown;
  }
}

class _DieFace extends StatelessWidget {
  const _DieFace({required this.number});
  final int number;

  @override
  Widget build(BuildContext context) => Container(
        width: 58,
        height: 58,
        alignment: Alignment.center,
        decoration: BoxDecoration(
          color: const Color(0xFFF3E8D0),
          borderRadius: BorderRadius.circular(12),
          border: Border.all(color: gold, width: 2),
        ),
        child: Text("$number",
            style: const TextStyle(
                color: Color(0xFF10182B),
                fontSize: 28,
                fontWeight: FontWeight.bold)),
      );
}

class GameTile extends StatelessWidget {
  const GameTile(
      {super.key,
      required this.title,
      required this.subtitle,
      required this.icon});
  final String title;
  final String subtitle;
  final IconData icon;

  @override
  Widget build(BuildContext context) => Card(
        color: const Color(0xFF1A2540),
        margin: const EdgeInsets.only(bottom: 16),
        elevation: 4,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20)),
        child: ListTile(
          contentPadding:
              const EdgeInsets.symmetric(horizontal: 20, vertical: 10),
          leading: Icon(icon, color: gold, size: 34),
          title:
              Text(title, style: const TextStyle(fontWeight: FontWeight.bold)),
          subtitle: Text(subtitle),
          trailing: const Icon(Icons.chevron_left, color: gold),
        ),
      );
}
